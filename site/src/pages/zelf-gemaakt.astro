---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { url } from '../nav';
---

<Layout>
	<div class="grid-2">
		<Card icon="🃏" title="Wiezen-scorebord" prompts={120} words={2420} time="9 uur" href="https://laoujin.github.io/WiezeScoren/">De punten voor wiezen bijhouden</Card>
		<Card icon="🎁" title="Secret Santa" prompts={2} words={225} time="30 min" href="https://secret-santa.sangu.be/">Lootjes trekken, met een geheime link per persoon</Card>
		<Card icon="💌" title="Uitnodigingen" prompts={50} words={876} time="4 uur" href="https://breibeest.github.io/guido-70/31-7/">Een website voor va zijn verjaardag, met QR-code</Card>
		<Card icon="📄" title="PDF Workbench" prompts={10} words={455} time="1 uur" href="https://dev.itenium.be/PdfMerge/">PDF's samenvoegen, splitsen, pagina's herschikken</Card>
	</div>

	<h3 class="ideas">🤯 En dit?</h3>
	<div class="grid-2">
		<Card icon="🎓" title="Deze workshop" prompts={136} words={3863} time="4,5 uur">De slides, deze website en de handout</Card>
	</div>

	<h3 class="ideas">💡 En jij?</h3>
	<div class="grid-3">
		<Card icon="🔤" title="Woordzoeker-maker" oneShot buildTime="7 min" href={url('woordzoeker/')}>Puzzels voor de (klein)kinderen, met hun eigen woorden</Card>
		<Card icon="🧠" title="Familiequiz" oneShot buildTime="7 min" href={url('familiequiz/')}>Wie kent oma het best?</Card>
		<Card icon="🍸" title="Cocktails" href="https://sangu.be/Sanguine-Spirits/">Je favoriete cocktailrecepten</Card>
		<Card icon="⏳" title="Aftellen" oneShot buildTime="6 min" href={url('aftellen/')}>Nog hoeveel nachtjes tot de vakantie?</Card>
		<Card icon="📚" title="Leesclub" oneShot>Wat lezen we, wanneer komen we samen, wie brengt koffie?</Card>
		<Card icon="🧳" title="Reisdagboek" oneShot>Foto's en verhaaltjes van je reis, per dag</Card>
		<Card icon="🌱" title="Planten water geven" oneShot buildTime="4 min" href={url('planten-water-geven/')}>Welke plant heeft vandaag water nodig?</Card>
		<Card icon="🎱" title="Bingokaarten" oneShot buildTime="6 min" href={url('bingokaarten/')}>Bingokaarten voor een feest of de klas</Card>
	</div>
</Layout>
