---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import LovableButton from '../components/LovableButton.astro';
---

<Layout>
	<div class="grid-3">
		<Card icon="📸" title="Plak een screenshot">Windows + Shift + S, daarna Ctrl + V in de chat</Card>
		<Card icon="🗣️" title="Zeg wat fout is">"Als ik op Opslaan klik, gebeurt er niets."</Card>
		<Card icon="↶" title="Ongedaan maken">Klik op <LovableButton icon="undo" /> onder het vorige bericht</Card>
	</div>
	<div class="ribbon">🙋 En anders: steek je hand op!</div>
</Layout>
