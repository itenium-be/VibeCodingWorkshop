---
import Layout from '../layouts/Layout.astro';
import Steps from '../components/Steps.astro';
import Step from '../components/Step.astro';
import Clicks from '../components/Clicks.astro';
import Copyable from '../components/Copyable.astro';
import { url } from '../nav';

const prompt = 'Zet in src/App.tsx op de BrowserRouter de prop basename={import.meta.env.BASE_URL}. Verander verder niets.';

// --base at build time keeps vite.config untouched, so Lovable's own preview at "/" keeps working.
const workflow = `name: Deploy to GitHub Pages
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: true
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: \${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: npm install
      - run: npm run build -- --base=/\${{ github.event.repository.name }}/
      - run: cp dist/index.html dist/404.html
      - uses: actions/upload-pages-artifact@v4
        with:
          path: dist
      - id: deployment
        uses: actions/deploy-pages@v4
`;
---

<Layout subtitle="Gratis online, op je eigen adres">
	<div class="note ask steps-start">Eerst nodig: <a href={url('lovable-koppelen/')}>Lovable gekoppeld</a> ✔️</div>
	<Steps>
		<Step icon="🔓" title="Maak je project openbaar">
			<p>Open je project op GitHub en klik:</p>
			<Clicks look="github" path={['Settings', 'Change visibility', 'Change to public', 'I have read and understand these effects', 'Make this repository public']} />
			<p>Iedereen kan nu je code lezen. Dat is nodig voor gratis hosting.</p>
		</Step>
		<Step icon="⚙️" title="Zet GitHub Pages aan">
			<Clicks look="github" path={['Settings', 'Pages', 'Source', 'GitHub Actions']} />
		</Step>
		<Step icon="🧭" title="Vraag Lovable één aanpassing">
			<p>Plak dit in de chat van Lovable:</p>
			<Copyable text={prompt} />
		</Step>
		<Step icon="🤖" title="Voeg de publiceer-robot toe">
			<p>Op GitHub, in je project:</p>
			<Clicks look="github" path={['Add file', 'Create new file']} />
			<p>Typ als naam <b>.github/workflows/deploy.yml</b> en plak dit erin:</p>
			<Copyable text={workflow} />
			<Clicks look="github" path={['Commit changes…', 'Commit changes']} />
		</Step>
		<Step icon="⏳" title="Wacht op het groene vinkje">
			<Clicks look="github" path={['Actions', 'Deploy to GitHub Pages']} />
			<p>Dat duurt een paar minuten.</p>
		</Step>
		<Step icon="🎉" title="Open je app">
			<p>Je adres staat bij <b>Settings → Pages</b>: <b>jouwnaam.github.io/jouwproject/</b></p>
			<p>Wat je voortaan in Lovable verandert, komt vanzelf online.</p>
		</Step>
		<Step icon="🔑" title="Heeft je app een login?">
			<p>Vraag de lesgever om je nieuwe adres toe te voegen. Anders sturen login-mails je terug naar Lovable.</p>
		</Step>
	</Steps>
	<div class="ribbon steps-end">🙋 Vast? Steek je hand op!</div>
</Layout>
