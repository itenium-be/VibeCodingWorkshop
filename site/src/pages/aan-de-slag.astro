---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import LovableButton from '../components/LovableButton.astro';
import { url } from '../nav';
---

<Layout>
	<div class="road road-stack">
		<Card icon="🔑" title="Inloggen" hint="Geen Lovable-mail? Vraag de lesgever."><span class="centered"><a class="pill pill-big" href="https://lovable.dev" target="_blank" rel="noopener">lovable.dev</a></span><br />Eerste keer? <a href={url('lovable-account/')}>Account activeren</a></Card>
		<Card icon="🛠️" title="Bouwen">
			<span class="lovable-box">
				<span class="lovable-text"><span class="callout-n">1</span>Beschrijf hier je app…</span>
				<span class="lovable-bar"><span class="lovable-plus">+</span><span class="lovable-mode"><span class="callout-n">2</span>Build<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></span><span aria-hidden="true">🎤</span><span class="callout-n">3</span><span class="lovable-send">↑</span></span>
			</span>
			<span class="callouts"><span><span class="callout-n">1</span>Typ je idee</span><span><span class="callout-n">2</span>Kies</span><span><span class="callout-n">3</span>Verstuur</span></span>
			<span class="modes">
				<span><b>💬 Chat</b>Praat over je idee. Je app verandert niet.</span>
				<span><b>🔨 Build</b>Lovable bouwt of verandert meteen je app.</span>
				<span><b>📋 Plan</b>Eerst een plan voor grote dingen. Jij keurt het goed.</span>
			</span>
			Daarna: 1 wijziging per keer
		</Card>
		<Card icon="🏠" title="Remix & Publish"><LovableButton icon="fork">Remix</LovableButton> naar <a href={url('mijn-workspace/')}>je eigen workspace</a><br /><LovableButton icon="globe">Publish</LovableButton> → <span class="pill">jouwnaam.lovable.app</span></Card>
	</div>
</Layout>
