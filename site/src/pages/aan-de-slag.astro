---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import LovableButton from '../components/LovableButton.astro';
---

<Layout>
	<div class="road">
		<Card icon="🔑" title="Inloggen" hint="Google-adres nog niet doorgegeven? Geef het aan de lesgever."><span class="centered"><a class="pill" href="https://lovable.dev" target="_blank" rel="noopener">lovable.dev</a></span></Card>
		<Card icon="🛠️" title="Bouwen">Brainstormen → 1 bericht<br />3 ontwerpen<br />1 wijziging per keer</Card>
		<Card icon="🏠" title="Publish & delen"><LovableButton icon="globe">Publish</LovableButton> → <span class="pill">jouwnaam.lovable.app</span></Card>
	</div>
</Layout>
