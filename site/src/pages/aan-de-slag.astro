---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import LovableButton from '../components/LovableButton.astro';
import { url } from '../nav';
---

<Layout>
	<div class="road">
		<Card icon="🔑" title="Inloggen" hint="Geen Lovable-mail? Vraag de lesgever."><span class="centered"><a class="pill" href="https://lovable.dev" target="_blank" rel="noopener">lovable.dev</a></span><br />Eerste keer? <a href={url('lovable-account/')}>Account activeren</a></Card>
		<Card icon="🛠️" title="Bouwen">Brainstormen → 1 bericht<br />3 ontwerpen<br />1 wijziging per keer</Card>
		<Card icon="🏠" title="Publish & delen"><LovableButton icon="globe">Publish</LovableButton> → <span class="pill">jouwnaam.lovable.app</span></Card>
	</div>
</Layout>
