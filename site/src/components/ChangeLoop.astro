---
const MESSAGES = ['Toon de route op een kaart', 'Voeg een vraag toe bij de Guido Gezellestraat', 'Doe een leuke animatie bij een correct antwoord'];
const BURST = ['🎉', '✨', '⭐', '🎊', '✨', '⭐', '🎉', '✨'];
const spread = (i: number) => {
	const a = i / BURST.length * Math.PI * 2;
	return `--dx: ${Math.round(Math.cos(a) * 70)}px; --dy: ${Math.round(Math.sin(a) * 45)}px`;
};
---

<div class="change-loop" data-done="3" data-messages={JSON.stringify(MESSAGES)}>
	<div class="lovable-box loop-box"><span class="loop-text" /><span class="lovable-send">↑</span></div>
	<div class="loop-app">
		<h4>🥾 Wandelquiz Lede</h4>
		<div class="loop-map" aria-hidden="true">
			<svg viewBox="0 0 200 70"><path d="M10 55 C 50 10, 90 65, 130 30 S 180 20, 190 12" /></svg>
			<span>📍</span>
		</div>
		<div class="loop-question">📍 Wie was Guido Gezelle?<span class="loop-correct">A. Een dichter<span class="loop-burst" aria-hidden="true">{BURST.map((b, i) => <i style={spread(i)}>{b}</i>)}</span><svg class="loop-cursor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2 L4 19 L8.5 15 L11.5 22 L14.5 20.7 L11.5 14 L17.5 14 Z" /></svg></span><span>B. Een schilder</span></div>
	</div>
	<div class="loop-count"><i /><i /><i /></div>
</div>

<script>
	const wait = (ms: number) => new Promise(r => setTimeout(r, ms));
	const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

	for (const loop of document.querySelectorAll<HTMLElement>('.change-loop')) {
		const messages: string[] = JSON.parse(loop.dataset.messages!);
		const text = loop.querySelector('.loop-text')!;
		const send = loop.querySelector('.lovable-send')!;
		const dots = [...loop.querySelectorAll('.loop-count i')];
		const show = (done: number) => {
			loop.dataset.done = String(done);
			dots.forEach((d, i) => d.classList.toggle('on', i < done));
		};

		if (reduced) {
			show(messages.length);
			loop.classList.add('hit');
			continue;
		}

		(async () => {
			for (;;) {
				loop.classList.remove('clicking', 'hit');
				show(0);
				await wait(900);
				for (const [i, message] of messages.entries()) {
					for (let n = 1; n <= message.length; n++) {
						text.textContent = message.slice(0, n);
						await wait(40);
					}
					await wait(300);
					send.classList.add('pressed');
					await wait(350);
					send.classList.remove('pressed');
					text.textContent = '';
					show(i + 1);
					await wait(1400);
				}
				loop.classList.add('clicking');
				await wait(650);
				loop.classList.add('hit');
				await wait(2500);
			}
		})();
	}
</script>
